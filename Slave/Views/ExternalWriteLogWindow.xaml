<Window x:Class="SimulatorApp.Slave.Views.ExternalWriteLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA下发指令"
        Width="460"
        Height="360"
        MinWidth="360"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#E5E7EB">
    <Border BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="BA下发指令"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#F8FAFC"
                       Margin="0,0,0,10"/>

            <TextBox x:Name="LogTextBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#020617"
                     Foreground="#E5E7EB"
                     BorderBrush="#334155"
                     BorderThickness="1"
                     Padding="10"
                     FontFamily="Consolas"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="清空"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Background="#1E293B"
                        Foreground="#E5E7EB"
                        BorderBrush="#475569"
                        Click="ClearButton_Click"/>
                <Button Content="关闭"
                        MinWidth="72"
                        Padding="12,6"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#3B82F6"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
