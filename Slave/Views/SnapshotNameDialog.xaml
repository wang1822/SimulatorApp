<Window x:Class="SimulatorApp.Slave.Views.SnapshotNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存快照"
        Width="360"
        Height="180"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="请输入快照名称"
                   Foreground="#E2E8F0"
                   FontSize="14"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Height="30"
                 Margin="0,12,0,0"
                 Background="#1E293B"
                 Foreground="#E2E8F0"
                 CaretBrush="#E2E8F0"
                 BorderBrush="#334155"
                 BorderThickness="1"
                 Padding="8,0"
                 VerticalContentAlignment="Center"
                 KeyDown="NameBox_KeyDown"/>

        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="2"
                   Margin="0,6,0,0"
                   Foreground="#F87171"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Width="72"
                    Height="28"
                    Margin="0,0,8,0"
                    Background="#334155"
                    Foreground="#E2E8F0"
                    BorderThickness="0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Content="确定"
                    Width="72"
                    Height="28"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
